# Self-checking UART bench. No cocotb: iverilog compiles, vvp runs the checks.
# From test/:  make -f Makefile.uart

ROOT = ..
SRC = $(ROOT)/src
PROG = $(ROOT)/prog
BUILD = sim_build

.PHONY: uart clean

uart: $(BUILD)/tb_uart.vvp $(BUILD)/uart_8n1.hex $(BUILD)/uart_8n1_nop.hex $(BUILD)/uart_a5_unrolled.hex
	vvp $(BUILD)/tb_uart.vvp

$(BUILD)/tb_uart.vvp: tb_uart.v $(SRC)/pin_engine.v $(SRC)/project.v | $(BUILD)
	iverilog -g2012 -o $@ -I$(SRC) $(SRC)/pin_engine.v $(SRC)/project.v tb_uart.v

$(BUILD)/uart_8n1.hex: $(PROG)/uart_8n1.asm $(PROG)/asm.py | $(BUILD)
	python3 $(PROG)/asm.py $(PROG)/uart_8n1.asm $@

$(BUILD)/uart_8n1_nop.hex: $(PROG)/uart_8n1_nop.asm $(PROG)/asm.py | $(BUILD)
	python3 $(PROG)/asm.py $(PROG)/uart_8n1_nop.asm $@

$(BUILD)/uart_a5_unrolled.hex: $(PROG)/uart_a5_unrolled.asm $(PROG)/asm.py | $(BUILD)
	python3 $(PROG)/asm.py $(PROG)/uart_a5_unrolled.asm $@

$(BUILD):
	mkdir -p $(BUILD)

clean:
	rm -rf $(BUILD) tb_uart.fst
